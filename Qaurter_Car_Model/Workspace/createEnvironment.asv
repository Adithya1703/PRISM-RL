function env = createEnvironment()
    % load you radar and suspension data
    s1 = load("D:\kedar project\PRISM-RL\Qaurter_Car_Model\samples_test\road_profile_ISO_8608_ClassA\Prediction_data\radarData.mat"); % should contain radar variable
    s2 = load("D:\kedar project\PRISM-RL\Qaurter_Car_Model\samples_test\road_profile_ISO_8608_ClassA\Prediction_data\SuspensionData.mat"); % should contain suspension variable

    if isfield(s1, 'radar')
        radar = s1.radar;
    else
        print("radar data not present")
    end

    if isfield(s2, 'suspension')
        suspension = s2.suspension;
    else
        print("suspension data not present")
    end


    % define reward weights
    rewardWeights = [1.0, 0.8, 0.3, 0.1, 0.05, 0.01, 0.01];
    envObj = PredictiveSuspensionEnv(radar, suspension, rewardWeights);

    % Wrap it using rlFUnctionEnv
    ObservationEnv = getObservationInfo(envObj);
    ActionInfo = getActionInfo(envObj);
    ResetHandle = @() resetAndReturnInitialObs(envObj);
    StepHandle = @(action, loggedSignals) step(envObj, action);
    

    env = rlFunctionEnv(ObservationEnv, ActionInfo, StepHandle, ResetHandle);
end

