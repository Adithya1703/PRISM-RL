classdef PredictiveSuspensionEnv < rl.env.MATLABEnvironment
    % PredictiveSuspensionEnv
    % Refactored to use Simulink Fast Restart and SimulationInput to avoid
    % full model recompilation on every step.
    %
    % Important:
    %  - ModelName should match your Simulink model filename (without .slx)
    %  - The Simulink model is expected to read variables:
    %       road_profile_time, road_profile_height, Kvar, Cvar
    %    from the base workspace or from the SimulationInput variables.
    %
    % External required helper functions on path:
    %   generate_iso8608_profile, simulateRadarPreview
    %
    % Author: refactor by assistant (with your original logic preserved)
    %
    properties
        % Timing
        Ts = 0.01;
        MaxSteps = 1600;
        maxTime = 10;

        % Episode bookkeeping
        CurrentStep = 1;
        StartIdx = 1;
        CurrentEpisode = 0;
        EpisodeLog = [];
        EpisodeRewardHistory = [];
        CurrentEpisodeReward = 0;

        % Data (optional precomputed)
        RadarData = [];
        SuspensionData = [];       % Nx6 [zs, zus, vs, vus, Ft, as]
        PrecomputedSuspension = []; % Nx6 fallback

        % Action/state
        k = 30000;
        c = 2500;
        msm_sms=300;
        mum_umu=47;
        kt=200000;
        ct = 300;
        PreviousAction = [0;0];

        % Optional actual k/c sequences
        actualK = [];
        actualC = [];

        % Reward weights (7 entries)
        RewardWeights = [0.40, 0.15, 0.15, 0.08, 0.12, 0.03, 0.02]; 

        % Scaling / normalization
        Scale_a = 15;
        Scale_j = 1500;
        Scale_F = 8000;
        Scale_dx = 0.10;
        Scale_dv = 1.0;
        Scale_dk = 10000;
        Scale_dc = 1000;
        scaleR = 10;

        % Simulink and workspace variable names
        ModelName = 'new_model_Qaurter_Car';  % <<-- set your model name here
        KVarName = 'Kvar';
        CVarName = 'Cvar';
        RoadTimeVar = 'road_profile_time';
        RoadHeightVar = 'road_profile_height';

        % Road generator settings (used when generating inside reset)
        RoadClasses = {'A','B','C','D'};
        RoadSpeed = 2;
        RoadDuration = 10;
        RoadFs = 100;

        % Expected logsout signal names (customize to your model)
        LoggedSignalNames = {'zs','zus','vs','vus','Ft','as'};
    end

    properties (Access = protected)
        State = zeros(7,1);   % [zr; zs; zus; vs; vus; Ft; as] (normalized except zr)
        RadarPreview = [];    % vector for the current episode
        RoadTime = [];
        RoadHeight = [];
        SimTime = 0;          % monotonic stop time used for sim()
    end

    methods
        %% Constructor, varagin contains mostly reward weights but we can add radar and suspension based on class declaration too
        function this = PredictiveSuspensionEnv(varargin)
            % Observation: 7-dim as described
            obsInfo = rlNumericSpec([7 1], 'LowerLimit', -inf*ones(7,1), 'UpperLimit', inf*ones(7,1));
            obsInfo.Name = 'states';
            actInfo = rlNumericSpec([2 1], 'LowerLimit', [10000;500], 'UpperLimit', [30000;3500]);
            actInfo.Name = 'actions';
        
            this = this@rl.env.MATLABEnvironment(obsInfo, actInfo);
        
            % Handle optional inputs safely
            if nargin >= 1 && ~isempty(varargin{1})
                this.RadarData = varargin{1}(:);
            end
            if nargin >= 2 && ~isempty(varargin{2})
                this.SuspensionData = varargin{2};
            end
            if nargin >= 3 && ~isempty(varargin{3})
                if numel(varargin{3}) ~= 7
                    error('RewardWeights must be length 7');
                end
                this.RewardWeights = varargin{3}(:).';
            end

            % --- Ensure model scalar parameters exist in base workspace BEFORE load_system ---
            try
                this.ensureWorkspaceParameters();   % assigns msm_sms, mum_umu, kt, ct into base
            catch ME
                warning('ensureWorkspaceParameters failed: %s', getReport(ME,'basic'));
            end
        
            % Fast Restart enable
            try
                load_system(this.ModelName);
                set_param(this.ModelName, 'FastRestart', 'on');
            catch ME
                warning('Could not enable FastRestart: %s', getReport(ME,'basic'));
            end
        end


        %% reset - start a new episode
        function initialObs = reset(this)
            % increment episode and log previous reward
            this.CurrentEpisode = this.CurrentEpisode + 1;
            if ~isempty(this.CurrentEpisodeReward)
                this.EpisodeRewardHistory(end+1) = this.CurrentEpisodeReward;
            end
            this.CurrentEpisodeReward = 0;

            % randomize actions initial
            this.k = 18000 + 4000*rand;
            this.c = 2000 + 1000*rand;
            this.PreviousAction = [this.k; this.c];

            % generate a new road and radar preview for this episode
            rc = this.RoadClasses{ randi(numel(this.RoadClasses)) };
            [rt, rh] = generate_iso8608_profile(rc, this.RoadSpeed, this.RoadDuration, round(this.RoadFs));
            this.RoadTime = rt(:);
            this.RoadHeight = rh(:);

            rv = simulateRadarPreview(rc, this.RoadTime, this.RoadHeight);
            this.RadarPreview = rv(:);

            % push arrays to base workspace in case model reads them directly
            try
                assignin('base', this.RoadTimeVar, this.RoadTime);
                assignin('base', this.RoadHeightVar, this.RoadHeight);
            catch ME
                warning('Could not write road arrays to base workspace: %s', getReport(ME,'basic'));
            end

            % initialize SimTime / CurrentStep
            this.SimTime = this.RoadTime(1);
            this.StartIdx = 1;
            this.CurrentStep = this.StartIdx;

            % push initial K/C to base workspace (blocks that read them directly)
            try
                assignin('base', this.KVarName, this.k);
                assignin('base', this.CVarName, this.c);
            catch
                warning('Could not write Kvar/Cvar to base workspace');
            end

            % Run a short sim to get starting signals (use SimulationInput & setVariable)
            try
                stopT = this.SimTime + this.Ts;

                simIn = Simulink.SimulationInput(this.ModelName);
                simIn = setModelParameter(simIn,'StopTime',num2str(stopT));
                % set variables for this run (these override base workspace for this sim call)
                simIn = setVariable(simIn, this.KVarName, this.k);
                simIn = setVariable(simIn, this.CVarName, this.c);
                simIn = setVariable(simIn, this.RoadTimeVar, this.RoadTime);
                simIn = setVariable(simIn, this.RoadHeightVar, this.RoadHeight);

                simOut = sim(simIn);
                this.SimTime = stopT;

                [zs, zus, vs, vus, Ft_val, as_val] = this.readSimSignals(simOut);
            catch ME
                % fallback to zeros if sim fails
                zs = 0; zus = 0; vs = 0; vus = 0; Ft_val = 0; as_val = 0;
                % Note: we do NOT throw here; training can still proceed with precomputed data
            end

            % build normalized initial observation
            zr0 = this.safeIndex(this.RadarPreview, this.CurrentStep);
            this.State = [ zr0; zs/this.Scale_dx; zus/this.Scale_dx; vs/this.Scale_dv; vus/this.Scale_dv; Ft_val/this.Scale_F; as_val/this.Scale_a ];

            initialObs = this.State;

            fprintf('Episode %d start: class=%s, startIdx=%d, SimTime=%0.3f\n', this.CurrentEpisode, rc, this.StartIdx, this.SimTime);
        end

        %% Ensure required variables exist in the base workspace
        function ensureWorkspaceParameters(this)
                names = {'msm_sms','mum_umu','kt','ct'};
                vals  = {this.msm_sms, this.mum_umu, this.kt, this.ct};
                for i = 1:numel(names)
                    try
                        if evalin('base', ['exist(''' names{i} ''',''var'')']) ~= 1
                            assignin('base', names{i}, vals{i});
                        else
                            assignin('base', names{i}, vals{i}); % overwrite anyway
                        end
                    catch ME
                        warning('Could not ensure base var %s: %s', names{i}, ME.message);
                    end
                end
        end
        


        %% step - one environment step
        function [obs, reward, isDone, loggedSignals] = step(this, action)
            % clip and validate action
            action = min(max(action, this.ActionInfo.LowerLimit), this.ActionInfo.UpperLimit);
            if numel(action) ~= 2
                error('Action must be 2-element vector [k;c]');
            end
            action = action(:);

            % Apply action internally
            this.k = action(1);
            this.c = action(2);

            % write to base workspace as fallback for model blocks that read globals
            try
                assignin('base', this.KVarName, this.k);
                assignin('base', this.CVarName, this.c);
            catch
                % not fatal
            end

            idx = this.CurrentStep;

            % safety check: if index beyond length of data, terminate
            if idx > length(this.RadarPreview) || idx > length(this.RoadTime)
                isDone = true;
                obs = this.State;
                reward = 0;
                loggedSignals = struct();
                return;
            end

            % Build SimulationInput and set variables (🔹 CHANGE: uses SimulationInput + setVariable)
            try
                stopT = this.SimTime + this.Ts;
                simIn = Simulink.SimulationInput(this.ModelName);
                simIn = setModelParameter(simIn, 'StopTime', num2str(stopT));

                % pass variables to this run --> avoids full recompile when FastRestart is on
                simIn = setVariable(simIn, this.KVarName, this.k);
                simIn = setVariable(simIn, this.CVarName, this.c);
                simIn = setVariable(simIn, this.RoadTimeVar, this.RoadTime);
                simIn = setVariable(simIn, this.RoadHeightVar, this.RoadHeight);

                % execute sim (Fast Restart will avoid recompile if model loaded with FastRestart=on)
                simOut = sim(simIn);
                this.SimTime = stopT;

                [zs, zus, vs, vus, Ft_val, as_val] = this.readSimSignals(simOut);
            catch ME
                % fallback to precomputed suspension if provided
                if ~isempty(this.PrecomputedSuspension) && size(this.PrecomputedSuspension,1) >= idx
                    zs  = this.PrecomputedSuspension(idx,1);
                    zus = this.PrecomputedSuspension(idx,2);
                    vs  = this.PrecomputedSuspension(idx,3);
                    vus = this.PrecomputedSuspension(idx,4);
                    Ft_val = this.PrecomputedSuspension(idx,5);
                    as_val = this.PrecomputedSuspension(idx,6);
                else
                    % if no fallback present, rethrow to surface meaningful error
                    rethrow(ME);
                end
            end

            % Derived quantities
            deflection = zs - zus;
            defl_vel = vs - vus;

            % jerk
            if idx > 1
                if ~isempty(this.PrecomputedSuspension) && size(this.PrecomputedSuspension,1) >= idx
                    as_prev = this.PrecomputedSuspension(idx-1,6);
                else
                    as_prev = this.State(end) * this.Scale_a; % denormalize saved last 'as' in State
                end
                jerk = (as_val - as_prev) / this.Ts;
            else
                jerk = 0;
            end

            % actuator deltas
            delta_k = action(1) - this.PreviousAction(1);
            delta_c = action(2) - this.PreviousAction(2);

            % normalized terms
            na = as_val / this.Scale_a;
            nj = jerk / this.Scale_j;
            nF = Ft_val / this.Scale_F;
            ndx = deflection / this.Scale_dx;
            ndv = defl_vel / this.Scale_dv;
            ndk = delta_k / this.Scale_dk;
            ndc = delta_c / this.Scale_dc;

            % soft saturation penalty
            sat = 2.0;
            sat_pen = max(0, abs(ndx) - 1).^2;

            % cost and reward (same as your formula)
            w = this.RewardWeights;
            if numel(w) ~= 7
                error('RewardWeights must have 7 elements');
            end

            cost = w(1)*(na)^2 + w(2)*(nj)^2 + w(3)*(nF)^2 + w(4)*(ndv)^2 + w(5)*(ndx)^2 + sat*sat_pen + w(6)*(ndk)^2 + w(7)*(ndc)^2;

            reward = 1 - tanh(cost / this.scaleR);
            if abs(ndx) <= 1 && abs(nF) <= 1 && abs(na) <= 1
                reward = reward + 0.02;
            end
            reward = max(min(reward, 1), -1);

            this.CurrentEpisodeReward = this.CurrentEpisodeReward + reward;

            % update normalized State
            zr = this.safeIndex(this.RadarPreview, idx);
            this.State = [ zr; zs/this.Scale_dx; zus/this.Scale_dx; vs/this.Scale_dv; vus/this.Scale_dv; Ft_val/this.Scale_F; as_val/this.Scale_a ];

            % update previous action
            this.PreviousAction = action(:);

            % logged signals & episode log
            loggedSignals = struct('State', this.State, 'Action', action, 'Cost', cost, 'Reward', reward);
            logIndex = max(1, min((idx - this.StartIdx + 1), this.MaxSteps));
            this.EpisodeLog(logIndex) = struct('State', this.State, 'Action', action, 'Reward', reward);

            % increment step and check termination
            this.CurrentStep = this.CurrentStep + 1;

            isDone = ( (this.CurrentStep - this.StartIdx) > this.MaxSteps ) || ( this.CurrentStep > length(this.RadarPreview) ) || ( (this.CurrentStep * this.Ts) >= this.maxTime );
            if isDone
                % push episode reward history (already done in reset as well)
                this.EpisodeRewardHistory(end+1) = this.CurrentEpisodeReward;
            end

            obs = this.State;
        end

        %% readSimSignals: extract last sample values from simOut.logsout
        function [zs, zus, vs, vus, Ft_val, as_val] = readSimSignals(this, simOut)
            zs=0; zus=0; vs=0; vus=0; Ft_val=0; as_val=0;
            try
                logs = simOut.logsout;
                % logs is a Simulink.SimulationData.Dataset
                for i = 1:numel(this.LoggedSignalNames)
                    name = this.LoggedSignalNames{i};
                    try
                        s = logs.get(name);   % returns SimulationData.Signal
                        data = s.Values.Data;
                        % Remove the last entry if length > 1
                        if numel(data) > 1
                            data = data(1:end-1);
                        end
                        lastVal = data(end);
                    catch
                        lastVal = 0;
                    end
                    switch name
                        case 'zs', zs = lastVal;
                        case 'zus', zus = lastVal;
                        case 'vs', vs = lastVal;
                        case 'vus', vus = lastVal;
                        case 'Ft', Ft_val = lastVal;
                        case 'as', as_val = lastVal;
                    end
                end
            catch
                % swallow: return zeros
            end
        end

        %% Utility: getActionBounds, getState, safeIndex, plot helpers
        function [kB, cB] = getActionBounds(this)
            kB = [this.ActionInfo.LowerLimit(1), this.ActionInfo.UpperLimit(1)];
            cB = [this.ActionInfo.LowerLimit(2), this.ActionInfo.UpperLimit(2)];
        end

        function s = getState(this)
            s = this.State;
        end

        function val = safeIndex(~, v, idx)
            if isempty(v)
                val = 0;
                return;
            end
            if idx <= length(v)
                val = v(idx);
            else
                val = v(end);
            end
        end

        function validLog = getValidEpisodeLog(this)
            filled = arrayfun(@(x) ~isempty(x.State), this.EpisodeLog);
            idx = find(filled, 1, 'last');
            if isempty(idx)
                validLog = [];
            else
                validLog = this.EpisodeLog(1:idx);
            end
        end

        function plotEpisode(this)
            log = this.getValidEpisodeLog();
            if isempty(log), warning('No episode log'); return; end
            zs_vals = arrayfun(@(x)x.State(2), log);
            vs_vals = arrayfun(@(x)x.State(4), log);
            figure; plot(zs_vals); hold on; plot(vs_vals); legend('zs','vs'); title('Episode'); xlabel('Time Step');
        end

        function plotRewardCurve(this, window)
            if nargin < 2, window = 5; end
            rewards = this.EpisodeRewardHistory;
            if isempty(rewards), disp('No reward history'); return; end
            if length(rewards) >= window
                movingAvg = movmean(rewards, window);
            else
                movingAvg = rewards;
            end
            figure; plot(rewards,'b-'); hold on; plot(movingAvg,'r-','LineWidth',2); xlabel('Episode'); ylabel('Total Reward'); title('Reward Curve');
        end
    end
end
